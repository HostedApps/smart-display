<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite requests for the backend API
  RewriteRule ^api/ - [L]

  # If requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to index.html for Angular SPA routing
  RewriteRule ^ index.html [L]
</IfModule>

# Caching rules: Ensure index.html is never cached, while hashed assets are cached
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Security: Prevent direct viewing of sensitive files
<FilesMatch "(^\.env|db\.php|\.sql$)">
  Order allow,deny
  Deny from all
</FilesMatch>
