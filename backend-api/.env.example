# Smart Display Backend Environment Configuration
# Copy this file to .env or place it outside public_html (e.g. /home/user/domains/domain.com/.env)

# Database Connection
DB_HOST=localhost
DB_NAME=u528878684_smart_display
DB_USER=u528878684_smart_user
DB_PASS=

# Security & Captcha Secret
CAPTCHA_SECRET=
MAX_SYSTEM_USERS=50

# Google reCAPTCHA v2 (Checkbox) Keys. Required in production: without a secret, captcha checks fail.
# The values below are Google's public test keys, which always validate successfully
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Google Identity Services (GIS) / Google Auth OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=

# AI briefing providers. A key here is used by every AI briefing widget that has no key of its own
# for that provider (the widget's Provider setting picks one). Leave blank to require per-widget keys.
# Google Gemini (also used by the AI flyer scanner)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Self-hosted OpenAI-compatible server (vLLM), e.g. https://llm.example.com/v1
VLLM_BASE_URL=
VLLM_API_KEY=
# Allow self-hosted server URLs on private networks (e.g. http://192.168.1.20:8000/v1). Only for
# self-hosted installs on the same network as their LLM server; never on a shared hosted service.
# ALLOW_PRIVATE_LLM_URLS=1
# Override API endpoints (a proxy, or the test suite's mock server)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# Mail / System Notification Sender
SMTP_FROM=noreply@smart-kiosk.online

# Test environments only (CI, local dev): accept the test runner's captcha token and skip
# verification when no reCAPTCHA secret is set. Never set this in production.
# ALLOW_TEST_CAPTCHA=1

# Encryption key for widget secrets (API keys, tokens): 32 random bytes, base64.
# Generate with: php -r 'echo base64_encode(random_bytes(32)), "\n";'
# If unset, a key file is created outside the web root (../../.sd_secrets_key) on first use.
# Back it up with the database: without it, stored secrets can't be decrypted.
# SECRETS_KEY=
