# Smart Display Backend Environment Configuration
# Copy this file to .env or place it outside public_html (e.g. /home/user/domains/domain.com/.env)

# Database Connection
DB_HOST=localhost
DB_NAME=u528878684_smart_display
DB_USER=u528878684_smart_user
DB_PASS=

# Security & Captcha Secret
CAPTCHA_SECRET=
MAX_SYSTEM_USERS=50

# Google reCAPTCHA v2 (Checkbox) Keys
# Defaults to Google's official testing keys which always validate successfully
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Google Identity Services (GIS) / Google Auth OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=

# Google Gemini Vision / AI API Key
GEMINI_API_KEY=

# Mail / System Notification Sender
SMTP_FROM=noreply@smart-kiosk.online
